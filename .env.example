# Public site URL (used for canonical links, sitemap and Open Graph). Confirm the live domain.
NEXT_PUBLIC_SITE_URL=https://lawandlawyers.in

# Enquiry form: Resend (primary)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "The Law & Lawyers <enquiries@lawandlawyers.in>"
RESEND_FROM=
# Recipient of enquiries (defaults to the address in content/site.ts)
CONTACT_TO=advocate@lawandlawyers.in

# Enquiry form: Formspree (fallback if Resend fails or is not configured), full endpoint URL
FORMSPREE_ENDPOINT=

# Optional privacy-friendly analytics. Loads only after the visitor accepts the disclaimer.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
